   Begin Object Name="MaterialExpressionCustom_0"
      Code="float3 ray = LocalPosition - LocalCamera;\nif (abs(ray.y) < 1.0e-5) return float2(-1.0, -1.0);\nfloat distance = (Depth - LocalCamera.y) / ray.y;\nif (distance <= 0.0) return float2(-1.0, -1.0);\nfloat2 projected = LocalCamera.xz + ray.xz * distance;\nreturn (projected - float2(OffsetX, OffsetY)) * float2(1.0, -1.0)\n    / max(abs(Size), 0.001) + 0.5;\n"
      OutputType=CMOT_Float2
      Description="Flat reticle projection (local X/Z)"
      Inputs(0)=(InputName="LocalPosition",Input=(Expression=MaterialExpressionTransformPosition'"M_ReflexSight_Glass:MaterialExpressionTransformPosition_0"'))
      Inputs(1)=(InputName="LocalCamera",Input=(Expression=MaterialExpressionTransformPosition'"M_ReflexSight_Glass:MaterialExpressionTransformPosition_1"'))
      Inputs(2)=(InputName="OffsetX",Input=(Expression=MaterialExpressionScalarParameter'"M_ReflexSight_Glass:MaterialExpressionScalarParameter_1"'))
      Inputs(3)=(InputName="OffsetY",Input=(Expression=MaterialExpressionScalarParameter'"M_ReflexSight_Glass:MaterialExpressionScalarParameter_2"'))
      Inputs(4)=(InputName="Size",Input=(Expression=MaterialExpressionScalarParameter'"M_ReflexSight_Glass:MaterialExpressionScalarParameter_3"'))
      Inputs(5)=(InputName="Depth",Input=(Expression=MaterialExpressionScalarParameter'"M_ReflexSight_Glass:MaterialExpressionScalarParameter_0"'))
      MaterialExpressionEditorX=-1700
      MaterialExpressionEditorY=550
      MaterialExpressionGuid=655E93C8478ACEE0E7984DB1CFA25479
      Material=Material'"M_ReflexSight_Glass"'
      Desc="Intersect the view ray with one flat X/Z plane in mesh space. Independent of glass curvature, UV islands and surface tangents."
   End Object
