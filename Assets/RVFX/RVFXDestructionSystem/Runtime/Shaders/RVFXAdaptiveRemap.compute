#pragma kernel PrepareContacts
#pragma kernel EvaluateRoots
#pragma kernel EvaluatePieces
#pragma kernel EvaluateDebrisEmitters

Texture2D<float4> _Positions, _Rotations, _Metadata;
Texture2D<float> _HeightMap;
RWTexture2D<float4> _Contacts, _Roots, _Output;
int _Pieces, _Frames, _UseMap;
float _FPS, _Time, _TargetHeight, _MaxFlight;
float4 _PositionMin, _PositionRange, _Encoding, _MapRect;
float3 _Gravity;
float4x4 _ToWorld, _FromWorld;

float4 QN(float4 q) { return q*rsqrt(max(dot(q,q),1e-12)); }
float4 QM(float4 a,float4 b) { return float4(a.w*b.xyz+b.w*a.xyz+cross(a.xyz,b.xyz),a.w*b.w-dot(a.xyz,b.xyz)); }
float4 QI(float4 q) { return float4(-q.xyz,q.w); }
float3 QR(float4 q,float3 p) { float3 t=2*cross(q.xyz,p); return p+q.w*t+cross(q.xyz,t); }
float4 QL(float4 a,float4 b,float t) { return QN(lerp(a,dot(a,b)<0?-b:b,t)); }
float3 DecodeP(float4 p) { return _Encoding.x>0.5?_PositionMin.xyz+saturate(p.xyz)*_PositionRange.xyz:p.xyz; }
float4 DecodeQ(float4 q) { return QN(_Encoding.y>0.5?q*2-1:q); }
void Pose(int p,float f,out float3 v,out float4 q)
{
    f=clamp(f,0,_Frames-1); int a=(int)floor(f),b=min(a+1,_Frames-1); float t=frac(f);
    v=lerp(DecodeP(_Positions.Load(int3(p,a,0))),DecodeP(_Positions.Load(int3(p,b,0))),t);
    q=QL(DecodeQ(_Rotations.Load(int3(p,a,0))),DecodeQ(_Rotations.Load(int3(p,b,0))),t);
}
float Height(float2 xz)
{
    if(_UseMap==0) return _TargetHeight;
    float2 uv=(xz-_MapRect.xy)/_MapRect.zw;
    if(any(uv<0)||any(uv>1)) return -1e19;
    uint w,h;_HeightMap.GetDimensions(w,h);
    // Conservative point footprint at discontinuities, never a fabricated ramp
    // between a ledge and empty space. Four texels also cover raster edge error.
    int2 a=(int2)floor(uv*float2(w,h)-.5),limit=int2(w-1,h-1);
    float h0=_HeightMap.Load(int3(clamp(a,int2(0,0),limit),0));
    float h1=_HeightMap.Load(int3(clamp(a+int2(1,0),int2(0,0),limit),0));
    float h2=_HeightMap.Load(int3(clamp(a+int2(0,1),int2(0,0),limit),0));
    float h3=_HeightMap.Load(int3(clamp(a+int2(1,1),int2(0,0),limit),0));
    return max(max(h0,h1),max(h2,h3));
}
float PointHeight(float2 xz)
{
    if(_UseMap==0)return _TargetHeight;
    float2 uv=(xz-_MapRect.xy)/_MapRect.zw;
    if(any(uv<0)||any(uv>1))return -1e19;
    uint w,h;_HeightMap.GetDimensions(w,h);
    return _HeightMap.Load(int3(clamp((int2)floor(uv*float2(w,h)),int2(0,0),int2(w-1,h-1)),0));
}
float SupportClearance(int root,float3 rp,float4 rq,float sourceFrame,bool referencePlane)
{
    float3 sp;float4 sq;Pose(root,sourceFrame,sp,sq);
    float4 delta=QM(rq,QI(sq));
    float4 members=_Metadata.Load(int3(root,3,0)); float result=1e19;
    for(int j=0;j<(int)members.y;j++)
    {
        int p=(int)_Metadata.Load(int3((int)members.x+j,4,0)).x;
        float3 pp;float4 pq;Pose(p,sourceFrame,pp,pq);
        pp=rp+QR(delta,pp-sp);pq=QM(delta,pq);
        uint metadataWidth,metadataHeight;_Metadata.GetDimensions(metadataWidth,metadataHeight);
        float4 support=metadataHeight>5?_Metadata.Load(int3(p,5,0)):float4(0,0,0,0);
        if(support.y>0)
        {
            for(int k=0;k<(int)support.y;k++)
            {
                // Support indices and the row stride are non-negative. Unsigned
                // division avoids the D3D11 signed-integer divide slow path.
                uint index=(uint)support.x+(uint)k;
                uint stride=(uint)max(_Pieces,1);
                float3 local=_Metadata.Load(int3(index%stride,6u+index/stride,0)).xyz;
                float3 world=mul(_ToWorld,float4(pp+QR(pq,local),1)).xyz;
                float h=referencePlane?mul(_ToWorld,float4(0,_Metadata.Load(int3(root,2,0)).w,0,1)).y:PointHeight(world.xz);
                if(h>-1e18)result=min(result,world.y-h);
            }
            continue;
        }
        float3 c=_Metadata.Load(int3(p,1,0)).xyz,e=_Metadata.Load(int3(p,2,0)).xyz;
        c=mul(_ToWorld,float4(pp+QR(pq,c),1)).xyz;
        float3 ext=abs(mul((float3x3)_ToWorld,QR(pq,float3(e.x,0,0))))
            +abs(mul((float3x3)_ToWorld,QR(pq,float3(0,e.y,0))))
            +abs(mul((float3x3)_ToWorld,QR(pq,float3(0,0,e.z))));
        float ground=referencePlane?mul(_ToWorld,float4(0,_Metadata.Load(int3(root,2,0)).w,0,1)).y:Height(c.xz);
        if(_UseMap!=0&&!referencePlane)
        {
            ground=max(ground,Height(c.xz+ext.xz*float2(1,1)));
            ground=max(ground,Height(c.xz+ext.xz*float2(-1,1)));
            ground=max(ground,Height(c.xz+ext.xz*float2(1,-1)));
            ground=max(ground,Height(c.xz-ext.xz));
        }
        if(ground>-1e18)result=min(result,c.y-ext.y-ground);
    }
    return result;
}
float Clearance(int root,float3 rp,float4 rq,float sourceFrame)
{ return SupportClearance(root,rp,rq,sourceFrame,false); }
float3 ChunkCenter(int root,float frame)
{
    float4 members=_Metadata.Load(int3(root,3,0));float3 center=0;float total=0;
    for(int j=0;j<(int)members.y;j++)
    {
        int member=(int)_Metadata.Load(int3((int)members.x+j,4,0)).x;
        float3 p;float4 q;Pose(member,frame,p,q);
        float3 c=_Metadata.Load(int3(member,1,0)).xyz,e=_Metadata.Load(int3(member,2,0)).xyz;
        float weight=max(e.x*e.y*e.z,1e-9);center+=(p+QR(q,c))*weight;total+=weight;
    }
    return center/max(total,1e-9);
}
float3 CenterAt(int root,float frame,float3 offset)
{float3 p;float4 q;Pose(root,frame,p,q);return p+QR(q,offset);}
float2 FlightPhases(int root,float4 m,float3 offset)
{
    float cut=m.w,landing=m.z>=0?m.z:m.w;
    float3 gravity=mul((float3x3)_ToWorld,_Gravity);
    if(length(gravity)<1e-5)return float2(cut,landing);
    float3 down=normalize(gravity);
    int window=max(1,min(4,(int)round(_FPS*.04)));
    // Existing grounded bakes may have hit other rubble before their first
    // reference-plane contact. Never replay that braking as free flight at a
    // new height. Detect an abrupt loss across two averaged velocity windows.
    // This is a preparation-time trajectory inference, not a collision callback;
    // authored later upward impulses are not distinguished by this prototype.
    int begin=(int)m.y+max(2*window,(int)ceil(_FPS*.12));
    for(int f=begin;f<=(int)m.w;f++)
    {
        float3 a=CenterAt(root,f-2*window,offset),b=CenterAt(root,f-window,offset),c=CenterAt(root,f,offset);
        float previous=dot(mul((float3x3)_ToWorld,(b-a)*(_FPS/window)),down);
        float current=dot(mul((float3x3)_ToWorld,(c-b)*(_FPS/window)),down);
        if(previous>.75 && previous-current>max(.3,previous*.04))
        {
            // Keep one complete pre-response interval for the exit velocity;
            // the first sample of a smoothed detection can already be braking.
            cut=max(m.y,f-2*window-1);
            landing=min(landing,max(cut+1,f-window));
            break;
        }
    }
    return float2(cut,landing);
}
void PrepareFlight(int root,float4 m)
{
    // Each root owns these rows. Volume-weighted piece bounds approximate its
    // mass centre; cache it once on the GPU, not inside the contact-search loop.
    float3 rp,bp;float4 rq,bq;Pose(root,m.w,rp,rq);
    float3 originalCenter=ChunkCenter(root,m.w);
    float2 phases=FlightPhases(root,m,QR(QI(rq),originalCenter-rp));
    float cut=phases.x,landing=phases.y;
    _Contacts[int2(root,2)]=float4(0,cut,landing,cut<m.w?1:0);
    Pose(root,cut,rp,rq);Pose(root,max(m.y,cut-1),bp,bq);
    float3 center=ChunkCenter(root,cut),before=ChunkCenter(root,max(m.y,cut-1));
    float4 dq=QM(rq,QI(bq));if(dq.w<0)dq=-dq;
    float len=length(dq.xyz),angle=2*atan2(len,max(0,dq.w));
    float3 angular=len>1e-6?dq.xyz*(angle*_FPS/len):float3(0,0,0);
    float3 hp;float4 hq;Pose(root,landing,hp,hq);
    _Contacts[int2(root,3)]=float4(QR(QI(rq),center-rp),SupportClearance(root,hp,hq,landing,true));
    // Find the recorded settling tail once, rather than forcing a new attitude
    // immediately after impact. No extra per-frame CPU work or motion readback.
    float3 endP;float4 endQ;Pose(root,_Frames-1,endP,endQ);
    float3 endC=endP+QR(endQ,QR(QI(rq),center-rp));
    float settled=landing;
    for(int f=_Frames-2;f>(int)settled;f--)
    {
        float3 fp;float4 fq;Pose(root,f,fp,fq);
        float3 fc=fp+QR(fq,QR(QI(rq),center-rp));
        if(length(fc-endC)>.04 || abs(dot(fq,endQ))<.999657)
        {settled=f+1;break;}
    }
    float blendEnd=max(settled+.35*_FPS,landing+1.1*_FPS);
    float blendStart=max(landing+.35*_FPS,blendEnd-1.25*_FPS);
    _Contacts[int2(root,4)]=float4((center-before)*_FPS,blendEnd);
    _Contacts[int2(root,5)]=float4(angular,blendStart);
    _Contacts[int2(root,6)]=float4(0,0,0,1);
}
float4 RestingTilt(int root,float4 hitQ)
{
    float3 p;float4 sourceHit,sourceEnd;
    Pose(root,_Contacts[int2(root,2)].z,p,sourceHit);Pose(root,_Frames-1,p,sourceEnd);
    float4 mappedEnd=QM(QM(sourceEnd,QI(sourceHit)),hitQ);
    float3 up=normalize(mul((float3x3)_FromWorld,float3(0,1,0)));
    float best=-1;float3 normal=up;
    // Closest face of the reference rest frame. This only corrects final tilt
    // (at most 54.74 degrees), preserving heading, never a 180-degree rewind.
    for(int axis=0;axis<3;axis++)
    {
        float3 a=axis==0?float3(1,0,0):axis==1?float3(0,1,0):float3(0,0,1);
        float3 candidate=QR(mappedEnd,QR(QI(sourceEnd),a));
        float d=dot(candidate,up);
        if(abs(d)>best){best=abs(d);normal=d<0?-candidate:candidate;}
    }
    return QN(float4(cross(normal,up),1+dot(normal,up)));
}
void Flight(int root,float t,out float3 p,out float4 q,out float frame)
{
    float cut=_Contacts[int2(root,2)].y;
    frame=min(t*_FPS,cut);Pose(root,frame,p,q);
    if(t*_FPS<=cut)return;
    float3 offset=_Contacts[int2(root,3)].xyz;
    float3 center=p+QR(q,offset),velocity=_Contacts[int2(root,4)].xyz;
    float dt=t-cut/_FPS;
    center+=velocity*dt+_Gravity*(.5*dt*dt);
    float3 angular=_Contacts[int2(root,5)].xyz;float speed=length(angular);
    float half=speed*dt*.5;
    float4 turn=speed>1e-6?float4(angular/speed*sin(half),cos(half)):float4(0,0,0,1);
    q=QN(QM(turn,q));
    p=center-QR(q,offset);
}
bool RecordedTailIsSupported(int root,float4 m)
{
    // A detached island can come to rest on retained masonry, never reaching
    // the reference floor. Recording end is not a new release event. Preserve
    // a settled, non-flight trajectory instead of inventing late freefall.
    // A chunk that travelled onto a rubble pile still needs remapping: a quiet
    // tail alone is not evidence that the original masonry supports it.
    if(m.z>=0 || _Contacts[int2(root,2)].w>.5)return false;
    int end=_Frames-1,window=max(4,(int)ceil(_FPS*.5));
    if(end-window<m.y)return false;
    float3 ep;float4 eq;Pose(root,end,ep,eq);
    float3 offset=_Contacts[int2(root,3)].xyz,ec=ep+QR(eq,offset);
    for(int f=end-window;f<end;f++)
    {
        float3 p;float4 q;Pose(root,f,p,q);
        if(length(mul((float3x3)_ToWorld,p+QR(q,offset)-ec))>.04 || abs(dot(q,eq))<.999657)
            return false;
    }
    return true;
}
[numthreads(64,1,1)]
void PrepareContacts(uint3 tid:SV_DispatchThreadID)
{
    int root=tid.x;if(root>=_Pieces)return;
    float4 m=_Metadata.Load(int3(root,0,0));if((int)m.x!=root)return;
    _Contacts[int2(root,0)]=float4(0,0,0,-1);
    _Contacts[int2(root,1)]=float4(0,0,0,1);
    _Contacts[int2(root,2)]=float4(0,0,0,0);
    PrepareFlight(root,m);
    if(RecordedTailIsSupported(root,m))
    {float4 phases=_Contacts[int2(root,2)];phases.x=1;_Contacts[int2(root,2)]=phases;return;}
    // At the reference plane preserve the complete original recording exactly.
    float floor=mul(_ToWorld,float4(0,_Metadata.Load(int3(root,2,0)).w,0,1)).y;
    if(_UseMap==0&&abs(floor-_TargetHeight)<.0001)
    { float4 phases=_Contacts[int2(root,2)];phases.x=1;_Contacts[int2(root,2)]=phases;return; }
    float start=m.y/_FPS,end=_Contacts[int2(root,2)].y/_FPS+_MaxFlight;
    float stepTime=max(1.0/60.0,(end-start)/2048.0);
    float previous=start;float3 p;float4 q;float frame;
    for(int step=0;step<=2048;step++)
    {
        float t=min(end,start+step*stepTime);Flight(root,t,p,q,frame);
        float d=Clearance(root,p,q,frame);
        if(d<=0)
        {
            float lo=previous,hi=t;
            for(int k=0;k<8;k++)
            { float mid=(lo+hi)*.5;Flight(root,mid,p,q,frame);if(Clearance(root,p,q,frame)>0)lo=mid;else hi=mid; }
            Flight(root,hi,p,q,frame);float lift=max(0,-Clearance(root,p,q,frame))+.002;
            p+=mul((float3x3)_FromWorld,float3(0,lift,0));
            _Contacts[int2(root,0)]=float4(p,hi);_Contacts[int2(root,1)]=q;
            _Contacts[int2(root,6)]=RestingTilt(root,q);return;
        }
        if(t>=end)break;previous=t;
    }
}
void EvaluateRootAt(int root,float time,out float3 p,out float4 q,out float frame)
{
    float4 m=_Metadata.Load(int3(root,0,0));
    float4 contact=_Contacts[int2(root,0)];
    if(_Contacts[int2(root,2)].x>.5 || time*_FPS<m.y)
    {frame=time*_FPS;Pose(root,frame,p,q);}
    else if(contact.w<0 || time<contact.w)
        Flight(root,time,p,q,frame);
    else
    {
        float elapsed=time-contact.w;
        float sourceHit=_Contacts[int2(root,2)].z;
        frame=sourceHit+elapsed*_FPS;
        float3 originalHit;float4 originalQ;Pose(root,sourceHit,originalHit,originalQ);
        float3 recorded;float4 recordedQ;Pose(root,frame,recorded,recordedQ);
        float3 offset=_Contacts[int2(root,3)].xyz;
        float4 hitQ=_Contacts[int2(root,1)];
        // Keep the new contact attitude. Apply recorded WORLD-space roll deltas;
        // never unwind a potentially 180-degree offset back to the source pose.
        q=QN(QM(QM(recordedQ,QI(originalQ)),hitQ));
        float restWeight=smoothstep(_Contacts[int2(root,5)].w,_Contacts[int2(root,4)].w,frame);
        q=QN(QM(QL(float4(0,0,0,1),_Contacts[int2(root,6)],restWeight),q));
        float3 recordedCenter=recorded+QR(recordedQ,offset);
        float3 originalCenter=originalHit+QR(originalQ,offset);
        float3 displacement=mul((float3x3)_ToWorld,recordedCenter-originalCenter);
        float3 center=contact.xyz+QR(hitQ,offset)
            +mul((float3x3)_FromWorld,float3(displacement.x,0,displacement.z));
        p=center-QR(q,offset);
        // Reuse the source's actual support clearance (bounce), not its pivot Y.
        // Re-seat in BOTH directions so changing orientation cannot accumulate
        // upward-only correction or leave the chunk floating above the floor.
        float bounce=max(0,SupportClearance(root,recorded,recordedQ,frame,true)-_Contacts[int2(root,3)].w);
        float d=Clearance(root,p,q,frame);
        if(d<1e18)p+=mul((float3x3)_FromWorld,float3(0,.002+bounce-d,0));
        else p+=mul((float3x3)_FromWorld,float3(0,displacement.y,0));
    }
}
[numthreads(64,1,1)]
void EvaluateRoots(uint3 tid:SV_DispatchThreadID)
{
    int root=tid.x;if(root>=_Pieces)return;
    if((int)_Metadata.Load(int3(root,0,0)).x!=root)return;
    float3 p;float4 q;float frame;EvaluateRootAt(root,_Time,p,q,frame);
    _Roots[int2(root,0)]=float4(p,frame);_Roots[int2(root,1)]=q;
}

struct DebrisEmitter { float4 source; float4 rotation; float4 timing; };
StructuredBuffer<DebrisEmitter> _DebrisEmitters;
RWStructuredBuffer<DebrisEmitter> _DebrisLaunches;
int _DebrisEmitterCount;
[numthreads(64,1,1)]
void EvaluateDebrisEmitters(uint3 tid:SV_DispatchThreadID)
{
    int i=tid.x;if(i>=_DebrisEmitterCount)return;
    DebrisEmitter input=_DebrisEmitters[i],result;
    int owner=(int)input.source.w;
    float spawn=input.timing.x;
    float3 pp=input.source.xyz;float4 pq=input.rotation;
    if(owner>=0 && owner<_Pieces)
    {
        int root=(int)_Metadata.Load(int3(owner,0,0)).x;
        if(root>=0)
        {
            float4 phase=_Contacts[int2(root,2)];
            if(input.timing.y>.5 && phase.x<.5)
            {
                float hit=_Contacts[int2(root,0)].w;
                if(hit<0)spawn=-1;
                else spawn+=hit*_FPS-phase.z;
            }
            float3 rp;float4 rq;float frame;
            EvaluateRootAt(root,max(0,spawn)/_FPS,rp,rq,frame);
            float3 sp;float4 sq;Pose(root,frame,sp,sq);Pose(owner,frame,pp,pq);
            float4 delta=QM(rq,QI(sq));pp=rp+QR(delta,pp-sp);pq=QM(delta,pq);
        }
        else Pose(owner,spawn,pp,pq);
    }
    // CPU/direct debris stores firstFrame as an integer. Use the same nearest
    // recorded frame for GPU emission, while retaining the exact contact pose.
    // Otherwise scale/height changes can shift GPU and fallback debris by half
    // a frame and visibly separate freshly emitted particles.
    result.source=float4(pp,spawn<0?-1:round(spawn));
    result.rotation=QN(QM(pq,QI(input.rotation)));
    result.timing=float4(input.source.xyz,input.timing.y);
    _DebrisLaunches[i]=result;
}
[numthreads(64,1,1)]
void EvaluatePieces(uint3 tid:SV_DispatchThreadID)
{
    int p=tid.x;if(p>=_Pieces)return;
    int root=(int)_Metadata.Load(int3(p,0,0)).x;
    float3 pp;float4 pq;
    if(root<0) Pose(p,_Time*_FPS,pp,pq);
    else
    {
        float4 r=_Roots[int2(root,0)],q=_Roots[int2(root,1)];
        float3 rp;float4 rq;Pose(root,r.w,rp,rq);Pose(p,r.w,pp,pq);
        float4 delta=QM(q,QI(rq));pp=r.xyz+QR(delta,pp-rp);pq=QM(delta,pq);
    }
    _Output[int2(p,0)]=float4(pp,1);_Output[int2(p,1)]=QN(pq);
}
