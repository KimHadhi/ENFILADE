#pragma kernel CSMain
#pragma kernel CSAdaptiveMain
#pragma kernel PrepareDebrisContacts
#pragma target 5.0

struct PointData
{
    int firstFrame;
    int sampleCount;
    int sampleOffset;
    int meshEntryIndex;
    float4 scaleRadius;
};

struct SampleData
{
    uint positionXY;
    uint positionZRotationX;
    uint rotationYZ;
    uint rotationW;
};

StructuredBuffer<PointData> _PointBuffer;
StructuredBuffer<SampleData> _SampleBuffer;
AppendStructuredBuffer<float4x4> _VisibleMatrices;

int _PointCount;
int _SamplesAreStreamed;
float _Frame;
int _EntryCount;
int _TargetMeshEntryIndex;
float4x4 _LocalToWorld;
float3 _PositionMin;
float3 _PositionRange;
float3 _ScaleMultiplier;

float4 NormalizeQuaternion(float4 q)
{
    float lenSq = max(dot(q, q), 0.0000001);
    return q * rsqrt(lenSq);
}

float DecodeUNorm16(uint value)
{
    return (float)(value & 0xFFFFu) / 65535.0;
}

float DecodeSNorm16(uint value)
{
    int signedValue = (int)(value & 0xFFFFu);
    if (signedValue >= 32768)
        signedValue -= 65536;
    return clamp((float)signedValue / 32767.0, -1.0, 1.0);
}

void DecodeSample(SampleData sampleData, out float3 position, out float4 rotation)
{
    float3 normalizedPosition = float3(
        DecodeUNorm16(sampleData.positionXY),
        DecodeUNorm16(sampleData.positionXY >> 16),
        DecodeUNorm16(sampleData.positionZRotationX));
    position = _PositionMin + normalizedPosition * max(
        _PositionRange,
        float3(0.000001, 0.000001, 0.000001));

    rotation = NormalizeQuaternion(float4(
        DecodeSNorm16(sampleData.positionZRotationX >> 16),
        DecodeSNorm16(sampleData.rotationYZ),
        DecodeSNorm16(sampleData.rotationYZ >> 16),
        DecodeSNorm16(sampleData.rotationW)));
}

float4 NlerpQuaternion(float4 a, float4 b, float t)
{
    if (dot(a, b) < 0.0)
        b = -b;

    return NormalizeQuaternion(lerp(a, b, t));
}

float SafeAbsFloat(float v)
{
    return v < 0.0 ? -v : v;
}

float3 SafeAbsFloat3(float3 v)
{
    return float3(SafeAbsFloat(v.x), SafeAbsFloat(v.y), SafeAbsFloat(v.z));
}

int ClampMeshEntryIndex(int value, int entryCount)
{
    int safeCount = max(1, entryCount);

    if (value < 0)
        return 0;

    if (value >= safeCount)
        return safeCount - 1;

    return value;
}

float4x4 BuildLocalTRS(float3 position, float4 rotation, float3 scale)
{
    rotation = NormalizeQuaternion(rotation);

    float x = rotation.x;
    float y = rotation.y;
    float z = rotation.z;
    float w = rotation.w;

    float xx = x * x;
    float yy = y * y;
    float zz = z * z;
    float xy = x * y;
    float xz = x * z;
    float yz = y * z;
    float wx = w * x;
    float wy = w * y;
    float wz = w * z;

    float r00 = 1.0 - 2.0 * (yy + zz);
    float r01 = 2.0 * (xy - wz);
    float r02 = 2.0 * (xz + wy);

    float r10 = 2.0 * (xy + wz);
    float r11 = 1.0 - 2.0 * (xx + zz);
    float r12 = 2.0 * (yz - wx);

    float r20 = 2.0 * (xz - wy);
    float r21 = 2.0 * (yz + wx);
    float r22 = 1.0 - 2.0 * (xx + yy);

    return float4x4(
        r00 * scale.x, r01 * scale.y, r02 * scale.z, position.x,
        r10 * scale.x, r11 * scale.y, r12 * scale.z, position.y,
        r20 * scale.x, r21 * scale.y, r22 * scale.z, position.z,
        0.0,           0.0,           0.0,           1.0);
}

#include "RVFXAdaptiveDebris.hlsl"

void DrawDebris(uint3 dispatchThreadId, bool adaptive)
{
    uint pointIndex = dispatchThreadId.x;
    if (pointIndex >= (uint)_PointCount)
        return;

    // Do not name this local variable "point".
    // Some D3D/HLSL compiler paths treat "point" as a reserved/token-like word.
    PointData pt = _PointBuffer[pointIndex];

    if (pt.sampleCount <= 0)
        return;

    int safeEntryCount = max(1, _EntryCount);
    int entryIndex = ClampMeshEntryIndex(pt.meshEntryIndex, safeEntryCount);

    if (entryIndex != _TargetMeshEntryIndex)
        return;

    float3 position = float3(0.0, 0.0, 0.0);
    float4 rotation = float4(0.0, 0.0, 0.0, 1.0);
    if(adaptive)
    {if(!DAdaptivePose(pointIndex,pt,position,rotation))return;}
    else
    {
    float localFrame = _Frame - (float)pt.firstFrame;
    float lastFrame = (float)(pt.sampleCount - 1);

    if (localFrame < 0.0 || localFrame > lastFrame)
        return;

    int frame0 = (int)floor(localFrame);

    if (frame0 < 0)
        frame0 = 0;

    if (frame0 >= pt.sampleCount)
        frame0 = pt.sampleCount - 1;

    int frame1 = frame0 + 1;
    if (frame1 >= pt.sampleCount)
        frame1 = pt.sampleCount - 1;

    float blend = saturate(localFrame - (float)frame0);

    int sampleIndex0 = _SamplesAreStreamed != 0
        ? (int)pointIndex * 2
        : pt.sampleOffset + frame0;
    int sampleIndex1 = _SamplesAreStreamed != 0
        ? sampleIndex0 + 1
        : pt.sampleOffset + frame1;

    SampleData sample0 = _SampleBuffer[sampleIndex0];
    SampleData sample1 = _SampleBuffer[sampleIndex1];

    float3 position0;
    float3 position1;
    float4 rotation0;
    float4 rotation1;
    DecodeSample(sample0, position0, rotation0);
    DecodeSample(sample1, position1, rotation1);

    position = lerp(position0, position1, blend);
    rotation = NlerpQuaternion(rotation0, rotation1, blend);
    }

    float radiusSize = max(0.001, pt.scaleRadius.w * 2.0);

    float sx = SafeAbsFloat(pt.scaleRadius.x);
    float sy = SafeAbsFloat(pt.scaleRadius.y);
    float sz = SafeAbsFloat(pt.scaleRadius.z);
    float bakedMax = max(sx, max(sy, sz));

    float baseSize = max(0.001, max(radiusSize, bakedMax));

    float3 scaleMultiplierAbs = SafeAbsFloat3(_ScaleMultiplier);
    float3 safeScaleMultiplier = max(scaleMultiplierAbs, float3(0.000001, 0.000001, 0.000001));
    float3 scale = float3(baseSize, baseSize, baseSize) * safeScaleMultiplier;

    float4x4 localMatrix = BuildLocalTRS(position, rotation, scale);
    float4x4 worldMatrix = mul(_LocalToWorld, localMatrix);
    _VisibleMatrices.Append(worldMatrix);
}
[numthreads(64,1,1)]
void CSMain(uint3 tid:SV_DispatchThreadID) { DrawDebris(tid,false); }
[numthreads(64,1,1)]
void CSAdaptiveMain(uint3 tid:SV_DispatchThreadID) { DrawDebris(tid,true); }
